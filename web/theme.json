    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "name": "Manrope",
          "slug": "standard-font",
          "fontFamily": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "400 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/manrope-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Label",
          "slug": "label",
          "size": "11px",
          "lineHeight": "1.2",
          "fontWeight": 800
        },
        {
          "name": "Meta",
          "slug": "meta",
          "size": "13px",
          "lineHeight": "1.4",
          "fontWeight": 400,
          "fontColor": "#555869"
        },
        {
          "name": "Klein",
          "slug": "small",
          "size": "14px",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "fontColor": "#1C1D2B"
        },
        {
          "name": "Tegeltekst",
          "slug": "tile",
          "size": "15px",
          "lineHeight": "1.5",
          "fontWeight": 400,
          "fontColor": "#3A3D52"
